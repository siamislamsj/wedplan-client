# --- Better Auth (runs inside this Next.js app) ---
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# --- MongoDB (same DB as the server) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=wedplan
# --- Google OAuth (redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --- Express API base URL (public) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Indicative display conversion only. Service prices and Stripe checkout remain USD.
NEXT_PUBLIC_USD_TO_BDT=124.75

NEXT_PUBLIC_CONTACT_EMAIL=contact@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=017*********
NEXT_PUBLIC_CONTACT_ADDRESS=Mirpur, Dhaka, Bangladesh
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_YOUTUBE_URL=
